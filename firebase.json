{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "crm-backend/**",
      "data/**",
      "*.zip",
      "**/*.py",
      "**/*.pyc",
      "**/serviceAccountKey.json",
      "**/*.pem",
      "**/*.key",
      "**/.env*",
      "**/README*",
      "**/package-lock.json",
      "**/skills-lock.json"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
